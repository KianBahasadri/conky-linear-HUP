# Linear overlay
LINEAR_API_KEY=lin_api_your_key_here
LINEAR_OVERLAY_ENABLED=1
LINEAR_TASK_STATES=Todo,In Progress
LINEAR_TASK_LIMIT=30
LINEAR_COMPETITION_TASK_LIMIT=50
LINEAR_BACKLOG_DUE_SOON_LIMIT=50
LINEAR_DONE_LOOKBACK_HOURS=18
LINEAR_PRIMARY_MONITOR_INDEX=0
PRIMARY_WAIT_SECONDS=20

# Rate limit panel (Codex + Claude + Cursor + Gemini + Grok + OpenCode Go + Command Code)
RATE_LIMIT_PANEL_ENABLED=1
# Bottom-edge gap in pixels for the rate limit panel.
RATE_LIMIT_PANEL_GAP_Y=6
# Adaptive polling: use the short interval for RATE_LIMIT_RECENT_CHANGE_WINDOW
# seconds after any usage change, then back off to the unchanged interval.
# RATE_LIMIT_CHANGED_INTERVAL=60
# RATE_LIMIT_UNCHANGED_INTERVAL=300
# RATE_LIMIT_RECENT_CHANGE_WINDOW=600
CLAUDE_PLAN_TYPE=pro
CLAUDE_USAGE_LABEL=claude
# CLAUDE_CREDENTIALS_PATH=/home/you/.claude/.credentials.json
# CLAUDE_AUTH_PATH=/home/you/.claude/.credentials.json
# CLAUDE_HOME=/home/you/.claude
# CLAUDE_USAGE_TTL=300
# CODEX_AUTH_PATH=/home/you/.local/share/clusterfork-auth/codex/auth.json
# CODEX_HOME=/home/you/.codex
# CODEX_SQLITE_HOME=/home/you/.codex
# CODEX_AUTH_STORE_DIR=/home/you/.local/share/clusterfork-auth/codex
# CODEX_USAGE_DEGENERATE_RETRIES=4
# CODEX_LOCAL_RATE_LIMIT_MAX_AGE_SECONDS=21600
# CURSOR_AUTH_PATH=/home/you/.local/share/clusterfork-auth/cursor/auth.json
# CURSOR_HOME=/home/you/.config/cursor
# CURSOR_AUTH_STORE_DIR=/home/you/.local/share/clusterfork-auth/cursor
# GEMINI_ANTIGRAVITY_STATE_DIR=/home/you/.gemini/antigravity-cli/rotate-auth
# GEMINI_CODE_ASSIST_ENDPOINT=https://daily-cloudcode-pa.googleapis.com
# GEMINI_ANTIGRAVITY_CLI=/usr/bin/agy
# GEMINI_AUTH_REFRESH_TIMEOUT_SECONDS=30
# GROK_AUTH_PATH=/home/you/.grok/auth.json
# GROK_HOME=/home/you/.grok
# GROK_CLI_CHAT_PROXY_BASE_URL=https://cli-chat-proxy.grok.com/v1
# OpenCode usage is read from the authenticated web dashboard. The session
# cookie is read from Firefox by default (log into opencode.ai once).
# OPENCODE_WORKSPACE_URL=https://opencode.ai/workspace/your-workspace-id/go
# OPENCODE_FIREFOX_PROFILE=upn9cnj5.default-release
# OPENCODE_FIREFOX_CONTAINER=your-container-name
# OPENCODE_COOKIE=auth=override_only_if_needed
# OPENCODE_USAGE_LABEL=default
# Command Code usage is read from ~/.commandcode/auth.json (cmd login).
# COMMAND_CODE_API_KEY takes precedence over the auth file, matching the CLI.
# COMMAND_CODE_HOME=/home/you/.commandcode
# COMMAND_CODE_AUTH_PATH=/home/you/.commandcode/auth.json
# COMMANDCODE_API_URL=https://api.commandcode.ai
# COMMAND_CODE_USAGE_LABEL=cmd

# Minecraft overlay
MINECRAFT_SERVER=mc.example.com:25565
MINECRAFT_SERVER_HOST=mc.example.com
MINECRAFT_SERVER_PORT=25565
MINECRAFT_SERVER_LABEL=Minecraft
MINECRAFT_OVERLAY_ENABLED=1
MINECRAFT_GAP_X=4
MINECRAFT_GAP_Y=6
MINECRAFT_REFRESH_SECONDS=60
MINECRAFT_STATUS_TIMEOUT_SECONDS=5
MINECRAFT_PROTOCOL_VERSION=-1
# Max seconds between successful polls before last-player idle time is discarded
MINECRAFT_LAST_SEEN_MAX_GAP_SECONDS=300

# PebbleHost Minecraft stats
PEBBLEHOST_API_KEY=ptlc_your_key_here
# Optional: set this if auto-matching MINECRAFT_SERVER to a PebbleHost allocation fails.
PEBBLEHOST_SERVER_ID=
PEBBLEHOST_API_TIMEOUT_SECONDS=10

# GitHub overlay
GITHUB_USERNAME=your-github-username
# GH_USERNAME=your-github-username
GITHUB_TOKEN=ghp_optional_token_here
GITHUB_OVERLAY_ENABLED=1
GITHUB_GAP_X=18
# Leave unset to auto-center the contribution rail between git (top) and
# Minecraft (bottom). Centering is live: the rail follows the git panel as repo
# rows come and go. Setting a value pins the rail and stops that.
# GITHUB_GAP_Y=320
# Optional auto-center tuning (only used when GITHUB_GAP_Y is unset):
# GITHUB_AUTO_MC_PANEL_H=126
# GITHUB_AUTO_RAIL_H=590
# GITHUB_AUTO_GAP_NUDGE_UP=0
# Extra inset on the primary monitor (GNOME top bar vs git normal window).
# Empty detects _NET_WORKAREA; 0 disables.
# GITHUB_AUTO_PRIMARY_GIT_EXTRA=32
GITHUB_REFRESH_SECONDS=1800
GITHUB_TIMEOUT_SECONDS=10

# Weather + outdoor running overlay
WEATHER_OVERLAY_ENABLED=1
# Optional exact coordinates. If omitted, WEATHER_LOCATION is geocoded; if all
# three are omitted, an approximate city is inferred from your public IP.
# WEATHER_LATITUDE=40.7128
# WEATHER_LONGITUDE=-74.0060
# WEATHER_LOCATION=New York, NY
# WEATHER_LOCATION_LABEL=New York, NY
WEATHER_UNITS=imperial
WEATHER_GAP_X=6
WEATHER_GAP_Y=6
WEATHER_REFRESH_SECONDS=600
WEATHER_TIMEOUT_SECONDS=10

# System resource monitor (right rail on every monitor)
RESOURCE_MONITOR_OVERLAY_ENABLED=1
RESOURCE_MONITOR_GAP_X=0
# Leave unset to follow Linear's per-monitor gap_y (keeps gauge tops flush with cards).
# RESOURCE_MONITOR_GAP_Y=34
# RESOURCE_HISTORY_SAMPLES=90
# RESOURCE_NET_GAUGE_WINDOW=6

# Affine monthly billing map (right side, above the weather panel)
BILLING_OVERLAY_ENABLED=1
# Leave horizontal gap unset to center on the weather panel.
# BILLING_GAP_X=0
# Leave vertical gap unset to sit just above the weather panel.
# BILLING_GAP_Y=350
BILLING_REFRESH_SECONDS=900
BILLING_TIMEOUT_SECONDS=30

# Current spend, balances, and ceilings are always fetched from the provider;
# the common EOM forecast is derived from live month pace. Never store a live
# cap, balance, or spend figure in this repo.
# AWS is pay-as-you-go: enable it with a billing-read IAM user. Run
# scripts/apply_aws_billing_iam.sh (needs a one-time `aws login` to create
# the user). The monthly COST budget (or a CloudWatch billing alarm) is the
# ceiling. Do not set a cap.
# BILLING_AWS_ENABLED=1
# BILLING_AWS_ACCESS_KEY_ID=
# BILLING_AWS_SECRET_ACCESS_KEY=
# BILLING_AWS_PROFILE=default
# BILLING_AWS_BUDGET_NAME=My Monthly Cost Budget
# BILLING_AWS_CACHE_TTL_SECONDS=86400

# Azure is prepaid: month-to-date credit spent is plotted against the live
# starting balance for the month. Enable it with the authenticated Azure CLI;
# do not set a cap.
# BILLING_AZURE_ENABLED=1
# BILLING_AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# OpenRouter needs a management key for live balance + trailing 30-day usage.
# Its forecast is future draw through the same EOM date, divided by today's
# available credit. No current value is stored in .env.
# OPENROUTER_API_KEY=sk-or-v1-your-management-key-here

# GitHub Actions uses the currently authenticated `gh` account and the
# official billing API. The token needs the `user` scope for a personal plan.
# BILLING_GITHUB_ACTIONS_ENABLED=1

# Blacksmith uses the authenticated `blacksmith` CLI. The advertised 3,000
# x64 2vCPU free minutes are the ceiling; do not set a cap.
# BILLING_BLACKSMITH_ENABLED=1
# BILLING_BLACKSMITH_ORG=your-github-org

# Local git status fleet (top-left)
GIT_OVERLAY_ENABLED=1
# Pinned paths are always included, then auto-scan adds recent home repos.
# GIT_REPO_PATHS=~/always-show-me:~/another-pin
# Blacklist by basename or path (drops from pin + scan). Colon/comma separated.
# GIT_REPO_BLACKLIST=dev-box:~/old-experiment
# GIT_SCAN_ROOT=~
# GIT_SCAN_DAYS=14
# GIT_SCAN_MAX_DEPTH=3
# GIT_SCAN_TTL_SECONDS=300
GIT_GAP_X=1
GIT_GAP_Y=1
GIT_REFRESH_SECONDS=30
# GIT_TIMEOUT_SECONDS=2
# GIT_MAX_REPOS=6
# GIT_HIDE_CLEAN=0
# GIT_INCLUDE_STASH=1
# GIT_DEFAULT_BRANCHES=main,master
# Per-row GitHub Actions pip (run / fail / ok). Uses `gh` (already authenticated).
# GIT_ACTIONS_ENABLED=1
# GIT_ACTIONS_TTL_SECONDS=180
# GIT_ACTIONS_RUNNING_TTL_SECONDS=20
# GIT_ACTIONS_EMPTY_TTL_SECONDS=300
