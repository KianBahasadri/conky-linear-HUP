conky.config = {
  -- bottom_left so gap_y pins the bottom edge, which is the roof line. The
  -- start script puts that line on the rate limit panel's top edge and matches
  -- this window's width to that panel's drawn frame; the renderer draws the
  -- skyline's plinth flush with the window bottom, so the two objects stack.
  alignment = 'bottom_left',
  background = true,
  border_width = 0,
  default_color = '000000',
  default_outline_color = '111827',
  default_shade_color = '111827',
  double_buffer = true,
  draw_borders = false,
  draw_graph_borders = false,
  draw_outline = false,
  draw_shades = false,
  extra_newline = false,
  font = 'JetBrains Mono:size=10',
  gap_x = 460,
  gap_y = 321,
  -- Pinned fallbacks. Auto placement replaces both: the width with the rate
  -- limit panel's drawn frame width, the height with GITHUB_SKYLINE_HEIGHT.
  minimum_height = 298,
  minimum_width = 1000,
  maximum_width = 1000,
  no_buffers = true,
  own_window = true,
  own_window_argb_visual = true,
  own_window_argb_value = 0,
  own_window_class = 'Conky',
  own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
  own_window_transparent = true,
  own_window_type = 'desktop',
  -- The skyline only changes when the contribution fetch lands, which is on
  -- GITHUB_REFRESH_SECONDS; this just has to be often enough to pick that up.
  update_interval = 60,
  use_xft = true,
  lua_load = './conky/overlay-entrypoint.lua',
  lua_draw_hook_post = 'draw_github_tracker',
}

conky.text = [[
]]
