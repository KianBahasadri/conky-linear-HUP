conky.config = {
  -- top_left so gap_y is distance from the top. When GITHUB_GAP_Y is unset the
  -- start script sizes this window to the whole band between the git panel and
  -- the Minecraft panel, and the renderer centers the rail inside it every draw.
  alignment = 'top_left',
  background = true,
  border_width = 0,
  default_color = '000000',
  default_outline_color = '111827',
  default_shade_color = '111827',
  double_buffer = true,
  draw_borders = false,
  draw_graph_borders = false,
  draw_outline = false,
  draw_shades = false,
  extra_newline = false,
  font = 'JetBrains Mono:size=10',
  gap_x = 18,
  gap_y = 320,
  -- Pinned fallback: tall enough for a 53-week column (7px square + 4px gap)
  -- plus edge pad. Auto placement replaces this with the band height.
  minimum_height = 600,
  minimum_width = 96,
  maximum_width = 96,
  no_buffers = true,
  own_window = true,
  own_window_argb_visual = true,
  own_window_argb_value = 0,
  own_window_class = 'Conky',
  own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
  own_window_transparent = true,
  own_window_type = 'desktop',
  -- Redraw often enough that the rail re-centers soon after a repo row comes
  -- or goes; the contribution fetch stays on GITHUB_REFRESH_SECONDS.
  update_interval = 15,
  use_xft = true,
  lua_load = './conky/overlay-entrypoint.lua',
  lua_draw_hook_post = 'draw_github_tracker',
}

conky.text = [[
]]
